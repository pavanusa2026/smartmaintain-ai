# SmartMaintain AI - Environment Configuration
# Copy to .env and adjust values

# Application
DEBUG=true
PORT=8080
LOG_LEVEL=INFO

# Demo data seeding (auto-enabled when DEBUG=true; set false to disable)
SEED_DEMO_DATA=true

# Storage: memory (local dev) | dynamodb (AWS)
STORAGE_BACKEND=memory

# AWS
AWS_REGION=us-east-1

# DynamoDB Tables
MACHINES_TABLE=smartmaintain-machines
ALERTS_TABLE=smartmaintain-alerts
WORK_ORDERS_TABLE=smartmaintain-work-orders
INSPECTIONS_TABLE=smartmaintain-inspections
USERS_TABLE=smartmaintain-users

# S3
SENSOR_BUCKET=smartmaintain-sensor-data
DOCUMENT_BUCKET=smartmaintain-documents

# AI Services
USE_LOCAL_MODEL=true
SAGEMAKER_ENDPOINT=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
MODEL_VERSION=1.0.0-local
AI_TIMEOUT_SECONDS=10
AI_MAX_RETRIES=2
MAX_UPLOAD_SIZE_MB=10

# Alert Thresholds
ANOMALY_THRESHOLD=0.65
FAILURE_THRESHOLD=0.70
CRITICAL_FAILURE_THRESHOLD=0.85

# Auth (local JWT mode)
AUTH_MODE=local
# REQUIRED in production (DEBUG=false): set a strong random secret, min 32 chars
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRE_MINUTES=480

# Login rate limiting
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Cognito (production)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1

# SNS
SNS_TOPIC_ARN=

# CORS — explicit origins only (never use wildcard in production)
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
